#!/usr/bin/env sh
# Wmux-scoped Codex shim. This directory is prepended only inside wmux panes.
# Ordinary terminals keep the user-level default (Hooks disabled).
# Trust bypass is process-scoped, so it never changes the user's global hook trust.

wmux_codex_shim_dir=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)
wmux_codex_real=''
wmux_codex_old_ifs=$IFS
IFS=:
for wmux_codex_dir in $PATH; do
  [ -n "$wmux_codex_dir" ] || wmux_codex_dir='.'
  wmux_codex_resolved_dir=$(CDPATH= cd -- "$wmux_codex_dir" 2>/dev/null && pwd)
  if [ "$wmux_codex_resolved_dir" != "$wmux_codex_shim_dir" ] && [ -x "$wmux_codex_dir/codex" ]; then
    wmux_codex_real="$wmux_codex_dir/codex"
    break
  fi
done
IFS=$wmux_codex_old_ifs
unset wmux_codex_old_ifs wmux_codex_dir wmux_codex_resolved_dir wmux_codex_shim_dir

if [ -z "$wmux_codex_real" ]; then
  echo 'codex: real Codex launcher not found outside the wmux shim directory.' >&2
  exit 1
fi

wmux_codex_hooks_configured=''
wmux_codex_hooks_disabled=''
wmux_codex_trust_configured=''
wmux_codex_previous_arg=''
for wmux_codex_arg in "$@"; do
  case "$wmux_codex_arg" in
    --)
      break
      ;;
    --dangerously-bypass-hook-trust)
      wmux_codex_trust_configured=1
      ;;
    --disable=hooks|features.hooks=false|--config=features.hooks=false|-c=features.hooks=false)
      wmux_codex_hooks_disabled=1
      ;;
    --enable=hooks|features.hooks=true|--config=features.hooks=true|-c=features.hooks=true)
      wmux_codex_hooks_configured=1
      ;;
    hooks)
      if [ "$wmux_codex_previous_arg" = '--disable' ]; then
        wmux_codex_hooks_disabled=1
      elif [ "$wmux_codex_previous_arg" = '--enable' ]; then
        wmux_codex_hooks_configured=1
      fi
      ;;
  esac
  wmux_codex_previous_arg=$wmux_codex_arg
done
unset wmux_codex_arg wmux_codex_previous_arg

if [ -n "$wmux_codex_hooks_disabled" ]; then
  exec "$wmux_codex_real" "$@"
fi
if [ -n "$wmux_codex_hooks_configured" ]; then
  if [ -n "$wmux_codex_trust_configured" ]; then
    exec "$wmux_codex_real" "$@"
  fi
  exec "$wmux_codex_real" --dangerously-bypass-hook-trust "$@"
fi
if [ -n "$wmux_codex_trust_configured" ]; then
  exec "$wmux_codex_real" --enable hooks "$@"
fi
exec "$wmux_codex_real" --dangerously-bypass-hook-trust --enable hooks "$@"
